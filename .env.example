# ==============================================================================
# GreenQuest — AI Outdoor Activity Planner Environment Configuration
# ==============================================================================

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Inference Provider Selection: 'huggingface' | 'ollama' | 'mock'
# - huggingface: Calls open-weight Gemma (e.g. google/gemma-2-2b-it) via Hugging Face Inference API / Serverless Endpoint
# - ollama: Calls local Gemma instance via Ollama (e.g. gemma2:2b) running at OLLAMA_BASE_URL
# - mock: Lightweight deterministic offline simulation generator for local development/testing without keys
GEMMA_PROVIDER=huggingface

# Hugging Face Settings (used if GEMMA_PROVIDER=huggingface)
# Get your free token at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
GEMMA_MODEL_ID=google/gemma-2-2b-it

# Ollama Settings (used if GEMMA_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Data Storage
DATABASE_PATH=data/greenquest.db
